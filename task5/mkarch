#!/bin/bash

set -euo pipefail

dir_path=""
name=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d)
            [[ $# -ge 2 ]] || { echo "Ошибка: -d требует аргумент" >&2; exit 1; }
            dir_path="$2"; shift 2 ;;
        -n)
            [[ $# -ge 2 ]] || { echo "Ошибка: -n требует аргумент" >&2; exit 1; }
            name="$2"; shift 2 ;;
        *) echo "Неизвестная опция: $1" >&2; exit 1 ;;
    esac
done

[[ -n "$dir_path" ]] || { echo "Ошибка: -d обязателен" >&2; exit 1; }
[[ -n "$name"    ]] || { echo "Ошибка: -n обязателен" >&2; exit 1; }
[[ -d "$dir_path" ]] || { echo "Ошибка: $dir_path не является каталогом" >&2; exit 1; }

{
cat <<'HEADER'
#!/bin/bash
set -euo pipefail

unpack_dir="."
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            [[ $# -ge 2 ]] || { echo "Ошибка: -o требует аргумент" >&2; exit 1; }
            unpack_dir="$2"; shift 2 ;;
        *) echo "Неизвестная опция: $1" >&2; exit 1 ;;
    esac
done

[[ -n "$unpack_dir" ]] || { echo "Ошибка: пустой путь распаковки" >&2; exit 1; }
mkdir -p "$unpack_dir"

base64 -d <<'ARCHIVE_END' | tar -xzf - -C "$unpack_dir"
HEADER

    tar -czf - -C "$dir_path" . | base64
    echo "ARCHIVE_END"
} > "$name"

chmod +x "$name"
echo "Создан самораспаковывающийся архив: $name"