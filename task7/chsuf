#!/bin/bash

[[ $# -eq 3 ]] || { echo "Использование: $0 <каталог> <старый_суффикс> <новый_суффикс>" >&2; exit 1; }
dir="$1"; old="$2"; new="$3"

[[ -d "$dir" ]] || { echo "Ошибка: '$dir' не каталог" >&2; exit 1; }
[[ "$old" =~ ^\.[^.]+$ ]] || { echo "Ошибка: невалидный старый суффикс '$old'" >&2; exit 1; }
[[ "$new" =~ ^\.[^.]+$ ]] || { echo "Ошибка: невалидный новый суффикс '$new'" >&2; exit 1; }

while IFS= read -r -d '' f; do
    p="${f##*/}"; p="${p%"$old"}"
    [[ "$p" != "${f##*/}" && -n "$p" ]] || continue	
    n="${f%"$old"}$new"
    [[ -e "$n" ]] && { echo "Пропуск: '$n' уже существует" >&2; continue; }
    mv -- "$f" "$n" && echo "Переименовано: $f -> $n"
done < <(find "$dir" -type f -print0)