#!/bin/bash

if [[ $# -ne 1 ]]; then
    echo "Ошибка: требуется ровно один аргумент — путь к каталогу" >&2
    exit 1
fi

if [[ ! -d "$1" ]]; then
    echo "Ошибка: '$1' не является каталогом" >&2
    exit 1
fi

declare -A stats

while IFS= read -r -d '' file; do
    base=${file##*/}

    if [[ "$base" == *.* ]]; then
        suffix=".${base##*.}"
        if [[ "$base" == .* && "$suffix" == "$base" ]]; then
            suffix="no suffix"
        fi
    else
        suffix="no suffix"
    fi

    stats["$suffix"]=$(( ${stats["$suffix"]:-0} + 1 ))
done < <(find "$1" -type f -print0)

for key in "${!stats[@]}"; do
    printf '%d\t%s\n' "${stats[$key]}" "$key"
done | sort -rn -k1,1 | while IFS=$'\t' read -r count suffix; do
    echo "$suffix: $count"
done